# Nothing camera extension service (vendor.noth.hardware.camera)
type vendor_hal_camera_default, domain;
type vendor_hal_camera_default_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_hal_camera_default)
hal_client_domain(vendor_hal_camera_default, hal_graphics_allocator)

add_service(vendor_hal_camera_default, vendor_hal_noth_camera_service)
binder_use(vendor_hal_camera_default)
binder_call(vendor_hal_camera_default, cameraserver)
binder_call(cameraserver, vendor_hal_camera_default)
binder_call(vendor_hal_camera_default, hal_camera_default)
binder_call(hal_camera_default, vendor_hal_camera_default)
binder_call(vendor_hal_camera_default, platform_app)
allow { cameraserver hal_camera_default platform_app system_server } vendor_hal_noth_camera_service:service_manager find;
allow vendor_hal_camera_default fwk_camera_service:service_manager find;
allow vendor_hal_camera_default vendor_hal_perf2_service:service_manager find;

set_prop(vendor_hal_camera_default, vendor_nothing_camera_prop)
get_prop(vendor_hal_camera_default, camera_config_prop)

allow vendor_hal_camera_default kmsg_device:chr_file rw_file_perms;
allow vendor_hal_camera_default sysfs:dir r_dir_perms;
allow vendor_hal_camera_default sysfs:file rw_file_perms;
allow vendor_hal_camera_default proc_meminfo:file r_file_perms;
allow vendor_hal_camera_default cgroup:file r_file_perms;
allow vendor_hal_camera_default vendor_data_file:dir create_dir_perms;
allow vendor_hal_camera_default vendor_data_file:file create_file_perms;
allow vendor_hal_camera_default vendor_xdsp_device:chr_file r_file_perms;
allow vendor_hal_camera_default vendor_qdsp_device:chr_file r_file_perms;
allow vendor_hal_camera_default adsprpcd_file:dir search;

hal_client_domain(vendor_hal_camera_default, hal_camera)
hal_client_domain(vendor_hal_camera_default, vendor_hal_perf)
get_prop(vendor_hal_camera_default, vendor_camera_prop)
allow vendor_hal_camera_default ntf_file:file r_file_perms;
