# Nothing sensor extension service
type vendor_sensor_extension_default, domain;
type vendor_sensor_extension_default_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(vendor_sensor_extension_default)
binder_use(vendor_sensor_extension_default)
add_service(vendor_sensor_extension_default, hal_sensor_extension_aidl_service)
allow vendor_sensor_extension_default self:qipcrtr_socket create_socket_perms_no_ioctl;

allow { system_server platform_app } hal_sensor_extension_aidl_service:service_manager find;
binder_call({ system_server platform_app }, vendor_sensor_extension_default)
